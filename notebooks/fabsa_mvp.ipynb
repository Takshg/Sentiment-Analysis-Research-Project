   "source": [
    "#  Explainable Sentiment Inference (LLM + Extractive Justifications)\n",
    "\n",
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b3661fdc",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "# --- Utilities: tokenization + attention-based salience + optional LLM ---\n",
    "import os\n",
    "import torch\n",
    "import numpy as np\n",
    "from typing import List, Optional, Dict, Any, Tuple\n",
    "\n",
    "_HAS_OPENAI = False\n",
    "try:\n",
    "    import openai  # If installed and OPENAI_API_KEY is set, will be used\n",
    "    _HAS_OPENAI = True\n",
    "except Exception:\n",
    "    _HAS_OPENAI = False\n",
    "\n",
    "def _softmax(x: np.ndarray) -> np.ndarray:\n",
    "    x = x - np.max(x, axis=-1, keepdims=True)\n",
    "    e = np.exp(x)\n",
    "    return e / np.sum(e, axis=-1, keepdims=True)\n",
    "\n",
    "def _rollup_attentions(attentions: Tuple[torch.Tensor, ...], mask: torch.Tensor) -> np.ndarray:\n",
    "    \"\"\"\n",
    "    attentions: tuple of layer attentions [num_layers x (B, heads, T, T)]\n",
    "    Returns token salience per example: (B, T)\n",
    "    \"\"\"\n",
    "    with torch.no_grad():\n",
    "        att = torch.stack(attentions, dim=0)  # (L, B, H, T, T)\n",
    "        att = att.mean(dim=2)                 # (L, B, T, T) average over heads\n",
    "        att = att / (att.sum(dim=-1, keepdim=True) + 1e-8)  # row-normalize\n",
    "        sal = att.sum(dim=-2)                 # (L, B, T): incoming attention\n",
    "        sal = sal.sum(dim=0)                  # (B, T): sum over layers\n",
    "        sal = sal * mask\n",
    "        sal = sal / (sal.sum(dim=-1, keepdim=True) + 1e-8)\n",
    "        return sal.cpu().numpy()\n",
    "\n",
    "def _highlight_tokens(tokens: List[str], sal: np.ndarray, topk:int=6) -> List[str]:\n",
    "    idx = np.argsort(-sal)[:topk]\n",
    "    idx = sorted(i for i in idx if i < len(tokens))\n",
    "    highlights = []\n",
    "    for i in idx:\n",
    "        t = tokens[i]\n",
    "        t = t.replace(\"▁\",\" \").replace(\"##\",\"\")\n",
    "        highlights.append(t)\n",
    "    return highlights\n",
    "\n",
    "def _format_extractive_rationale(text: str, highlights: List[str], label: str, aspect: Optional[str]) -> str:\n",
    "    if aspect:\n",
    "        base = f\"The review shows **{label}** sentiment toward **{aspect}**.\"\n",
    "    else:\n",
    "        base = f\"The review shows **{label}** sentiment.\"\n",
    "    if highlights:\n",
    "        quoted = \", \".join([f'\\\"{h.strip()}\\\"' for h in highlights if h.strip()])\n",
    "        return base + f\" Cues include {quoted}.\"\n",
    "    return base\n",
    "\n",
    "def _maybe_llm_justify(text: str, label: str, highlights: List[str], aspect: Optional[str]) -> Optional[str]:\n",
    "    if not _HAS_OPENAI:\n",
    "        return None\n",
    "    api_key = os.getenv(\"OPENAI_API_KEY\", \"\")\n",
    "    if not api_key:\n",
    "        return None\n",
    "    try:\n",
    "        openai.api_key = api_key\n",
    "        system = \"You are an expert annotator for aspect-based sentiment analysis. Keep answers under 80 words.\"\n",
    "        cues = \", \".join(highlights[:6]) if highlights else \"\"\n",
    "        aspect_txt = f\"aspect: {aspect}\" if aspect else \"no specific aspect\"\n",
    "        user = f\"Text: {text}\\nPredicted label: {label}\\nCues: {cues}\\nTask: Briefly justify the label in plain language, citing phrases.\"\n",
    "        # Compatible call; users may upgrade to the newest OpenAI SDK pattern in Colab.\n",
    "        resp = openai.ChatCompletion.create(\n",
    "            model=\"gpt-4o-mini\",\n",
    "            messages=[{\"role\":\"system\",\"content\":system},\n",
    "                      {\"role\":\"user\",\"content\":user}],\n",
    "            temperature=0.2,\n",
    "            max_tokens=120\n",
    "        )\n",
    "        return resp[\"choices\"][0][\"message\"][\"content\"].strip()\n",
    "    except Exception:\n",
    "        return None\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "19a39475",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "# --- Main entrypoint: predict_with_explanation ---\n",
    "from typing import Union\n",
    "\n",
    "def predict_with_explanation(\n",
    "    texts: Union[str, List[str]], \n",
    "    aspects: Optional[Union[str, List[Optional[str]]]] = None,\n",
    "    max_length: int = 256,\n",
    "    topk_highlights: int = 6,\n",
    ") -> List[Dict[str, Any]]:\n",
    "    \"\"\"\n",
    "    Runs inference with attention-based evidence and optional LLM justification.\n",
    "    Expects existing variables: model, tokenizer, id2label (optional), device (optional).\n",
    "    \"\"\"\n",
    "    # Resolve device\n",
    "    device_ = globals().get(\"device\", torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\"))\n",
    "    mdl = globals()[\"model\"].to(device_)\n",
    "    tok = globals()[\"tokenizer\"]\n",
    "    mdl.eval()\n",
    "\n",
    "    # Normalize inputs\n",
    "    if isinstance(texts, str):\n",
    "        texts = [texts]\n",
    "    if aspects is None:\n",
    "        aspects = [None] * len(texts)\n",
    "    elif isinstance(aspects, str):\n",
    "        aspects = [aspects] * len(texts)\n",
    "    assert len(texts) == len(aspects), \"texts and aspects must be same length\"\n",
    "\n",
    "    # Tokenize: if training used pair-format, we mimic via a simple [ASPECT] marker\n",
    "    batch_inputs = []\n",
    "    for t, a in zip(texts, aspects):\n",
    "        pair = f\"{t} [ASPECT] {a}\" if a else t\n",
    "        batch_inputs.append(pair)\n",
    "\n",
    "    encoded = tok(\n",
    "        batch_inputs,\n",
    "        padding=True,\n",
    "        truncation=True,\n",
    "        max_length=max_length,\n",
    "        return_tensors=\"pt\"\n",
    "    )\n",
    "    encoded = {k: v.to(device_) for k, v in encoded.items()}\n",
    "\n",
    "    with torch.no_grad():\n",
    "        outputs = mdl(**encoded, output_attentions=True, return_dict=True)\n",
    "        logits = outputs.logits                 # (B, C)\n",
    "        probs = torch.softmax(logits, dim=-1)\n",
    "        pred_ids = probs.argmax(dim=-1).cpu().numpy()\n",
    "\n",
    "    # Resolve label strings\n",
    "    id2label = globals().get(\"id2label\", None)\n",
    "    if isinstance(id2label, dict):\n",
    "        labels = [id2label.get(int(i), str(int(i))) for i in pred_ids]\n",
    "    else:\n",
    "        label_vocab = {0:\"negative\", 1:\"neutral\", 2:\"positive\"}\n",
    "        labels = [label_vocab.get(int(i), str(int(i))) for i in pred_ids]\n",
    "\n",
    "    # Attention salience\n",
    "    mask = encoded[\"attention_mask\"].float()\n",
    "    sal = _rollup_attentions(outputs.attentions, mask)  # (B, T)\n",
    "\n",
    "    tokens_batch = [tok.convert_ids_to_tokens(seq.tolist()) for seq in encoded[\"input_ids\"]]\n",
    "    results = []\n",
    "    for i, (text, aspect, label) in enumerate(zip(texts, aspects, labels)):\n",
    "        highlights = _highlight_tokens(tokens_batch[i], sal[i], topk=topk_highlights)\n",
    "        extractive = _format_extractive_rationale(text, highlights, label, aspect)\n",
    "        llm = _maybe_llm_justify(text, label, highlights, aspect)\n",
    "        results.append({\n",
    "            \"text\": text,\n",
    "            \"aspect\": aspect,\n",
    "            \"label\": label,\n",
    "            \"probabilities\": probs[i].cpu().numpy().tolist(),\n",
    "            \"highlights\": highlights,\n",
    "            \"explanation_extractive\": extractive,\n",
    "            \"explanation_llm\": llm or extractive\n",
    "        })\n",
    "    return results\n"
   ]
  },
  {
